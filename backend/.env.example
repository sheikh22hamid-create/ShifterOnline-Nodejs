DATABASE_URL="mysql://root:password@localhost:3306/shifter_online"
PORT=5000

# Admin panel auth (Phase 1)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: Google Distance Matrix API key for real road-distance fare
# calculation. Without it, getRoadDistanceKm falls back to haversine
# (straight-line) x ROAD_DISTANCE_FUDGE_FACTOR, which is noticeably less
# accurate over long routes.
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: absolute path to the legacy PHP admin's public_html/admin folder
# (the parent of its "images" subfolder), for serving KYC/vehicle/category
# document images stored as e.g. "images/vehicle/x.jpg" in the DB. Leave
# unset if that folder isn't available locally — the app still runs fine,
# document previews just won't load.
# LEGACY_IMAGES_DIR=/absolute/path/to/php backend/public_html/admin

# Firebase service-account credentials — required for driver/customer push
# notifications. Set exactly ONE of the three (checked in this order):
# FIREBASE_SERVICE_ACCOUNT_JSON=<the full service-account JSON as a single-line string>
# FIREBASE_SERVICE_ACCOUNT_BASE64=<the service-account JSON, base64-encoded — the one Render uses>
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/shifter-new-firebase-adminsdk-fbsvc-xxxxx.json

# 2Factor.in SMS OTP account used by customerAuthController/riderAuthController
# (services/otpService.js) for send-otp/verify-otp. Same account the legacy
# PHP cust_api/rider_api used (key was hardcoded there) - moved to env here.
# Falls back to that same hardcoded key if unset, so nothing breaks if you
# don't set this locally, but set it in every real deployment.
TWOFACTOR_API_KEY=8b7c5cf8-49dd-11f1-9800-0200cd936042

# Driver-app OTP test bypass (fixed OTP 123456 for 99999xxxxx/88888xxxxx
# numbers) - OFF by default. The legacy PHP left this on unconditionally,
# including in production. Set to "true" only in dev/staging.
# ENABLE_OTP_TEST_MODE=true

# Razorpay credentials used by customerWalletController.addWallet: KEY_ID +
# KEY_SECRET verify the checkout HMAC signature AND (since the signature
# alone doesn't cover the amount) fetch the payment from Razorpay's API to
# confirm status=captured and the real paid amount before crediting any
# wallet. The legacy PHP had a Razorpay TEST key hardcoded; Node has no
# fallback - without both set, wallet recharge requests are refused.
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Static app-level key the driver app sends as the Authorization header on
# a handful of rider_api-ported endpoints (KYC document/bank/vehicle
# uploads, dynamic questions/survey). Same trust model as the legacy PHP's
# hardcoded 'genie_rest_key' - it's baked into the app binary, not a
# per-user secret. Falls back to that same value if unset.
# APP_REST_KEY=genie_rest_key

# Signs the token in customer invoice links (orderInvoiceController.js).
# The legacy PHP had `$SECRET_KEY = "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"`
# hardcoded VERBATIM (never actually changed), so that placeholder string
# alone was enough to forge a valid link to any customer's invoice. No
# fallback here - required, and must actually be random.
# INVOICE_SECRET_KEY=set-a-long-random-string-here

# Public base URL this backend is reachable at, used to build the invoice
# link returned by /api/order/invoice-url (e.g. https://api.shifteronline.com).
# PUBLIC_BASE_URL=https://shifteronline-nodejs-dev.onrender.com

# Cloudinary — where every file upload (KYC docs, vehicle/bank photos, bill
# uploads, kit images, order photos, profile pictures) actually lives.
# Render's own disk is ephemeral (wiped on every deploy), so nothing gets
# written to backend/public/images at runtime anymore — see
# utils/cloudinaryStorage.js. Without these three set, uploads fall back to
# local disk (fine for local dev, NOT durable in production).
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

