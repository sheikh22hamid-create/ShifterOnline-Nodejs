DATABASE_URL="mysql://root:password@localhost:3306/shifter_online"
PORT=5000

# Admin panel auth (Phase 1)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: Google Distance Matrix API key for real road-distance fare
# calculation. Without it, getRoadDistanceKm falls back to haversine
# (straight-line) x ROAD_DISTANCE_FUDGE_FACTOR, which is noticeably less
# accurate over long routes.
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: absolute path to the legacy PHP admin's public_html/admin folder
# (the parent of its "images" subfolder), for serving KYC/vehicle/category
# document images stored as e.g. "images/vehicle/x.jpg" in the DB. Leave
# unset if that folder isn't available locally — the app still runs fine,
# document previews just won't load.
# LEGACY_IMAGES_DIR=/absolute/path/to/php backend/public_html/admin

# Firebase service-account credentials — required for driver/customer push
# notifications. Set exactly ONE of the three (checked in this order):
# FIREBASE_SERVICE_ACCOUNT_JSON=<the full service-account JSON as a single-line string>
# FIREBASE_SERVICE_ACCOUNT_BASE64=<the service-account JSON, base64-encoded — the one Render uses>
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/shifter-new-firebase-adminsdk-fbsvc-xxxxx.json

