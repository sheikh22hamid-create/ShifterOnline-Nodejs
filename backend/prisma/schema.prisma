generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Pkg_tracking {
  id      Int    @id @default(autoincrement())
  link    String @db.Text
  orderid Int
  uid     Int
}

model admin {
  id       Int         @id @default(autoincrement())
  username String      @db.LongText
  password String      @db.LongText
  role     admin_role? @default(admin)
  city_id  Int?
}

model app_settings {
  id            Int       @id @default(autoincrement())
  setting_key   String?   @unique(map: "setting_key") @db.VarChar(100)
  setting_value String?   @db.VarChar(255)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
}

model buy_order {
  id                        Int                @id @default(autoincrement())
  rid                       Int                @default(0)
  uid                       Int
  flow_id                   Int                @default(0)
  o_status                  buy_order_o_status @default(Pending)
  distance                  Float              @db.Float
  d_charge                  Decimal            @db.Decimal(10, 2)
  extra_mile_charge         Float              @db.Float
  total_dcharge             Decimal            @db.Decimal(10, 2)
  cou_id                    Int                @default(0)
  cou_amt                   Float              @default(0) @db.Float
  title                     String             @db.Text
  pick_address              String             @db.Text
  pick_lat                  String             @db.Text
  pick_long                 String             @db.Text
  drop_address              String             @db.Text
  drop_lat                  String             @db.Text
  drop_long                 String             @db.Text
  total_amt                 Float              @default(0) @db.Float
  item_total                Float              @default(0) @db.Float
  service_charge            Float              @default(0) @db.Float
  p_method_id               Float              @db.Float
  transaction_id            String             @db.Text
  order_date                DateTime?          @db.DateTime(0)
  delivery_date             DateTime?          @db.DateTime(0)
  commission                Float              @db.Float
  comment_reject            String?            @db.Text
  pick_type                 String             @db.Text
  drop_type                 String             @db.Text
  drop_name                 String             @db.Text
  time_duration             Float              @db.Float
  service_charge_percentage Float              @default(0) @db.Float
  bill_img                  String?            @db.Text
  service_payment_id        Int                @default(0)
  service_transaction_id    String?            @db.Text
  is_rate                   Int?               @default(0)
  cust_rate                 Int?               @default(0)
  cust_comment              String?            @db.Text
  drop_mobile               String             @db.Text
}

model buy_order_item {
  id           Int     @id @default(autoincrement())
  order_id     Int
  item_title   String  @db.Text
  quantity     Float   @db.Float
  item_img     String? @db.Text
  item_total   Float?  @db.Float
  item_confirm Int     @default(0)
  is_available Int     @default(1)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model driver_activity {
  id                  Int
  driver_id           Int
  time_duration       Int
  date                DateTime @db.Date
  ride_count          Int
  driver_schudle_type String   @db.VarChar(20)
  zone                String   @db.VarChar(20)
  total_fair_monthly  Int

  @@ignore
}

model driver_withdraw_requests {
  id         Int                              @id @default(autoincrement())
  rider_id   Int?
  amount     Decimal?                         @db.Decimal(10, 2)
  status     driver_withdraw_requests_status? @default(pending)
  city_id    Int?
  created_at DateTime?                        @default(now()) @db.Timestamp(0)
}

model make_list_item {
  id       Int    @id @default(autoincrement())
  uid      Int
  title    String @db.Text
