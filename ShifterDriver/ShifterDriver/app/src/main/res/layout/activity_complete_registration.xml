<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_canvas"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/white">
        <ImageView
            android:id="@+id/img_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back_left"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/partner_back"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/complete_registration_btn"
            android:textSize="20sp"
            android:textColor="@color/driver_text_primary"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reg_remaining_title"
                android:textSize="22sp"
                android:textColor="@color/driver_text_primary"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:text="@string/reg_remaining_subtitle"
                android:textSize="13sp"
                android:textColor="@color/home_secondary" />

            <TextView
                android:id="@+id/tv_nothing_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/reg_nothing_pending"
                android:textSize="15sp"
                android:textColor="@color/driver_text_primary"
                android:padding="20dp"
                android:background="@drawable/profile_card" />

            <!-- PAN -->
            <LinearLayout
                android:id="@+id/card_pan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/profile_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PAN Card"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tv_pan_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/reg_status_pending"
                    android:textSize="13sp"
                    android:textColor="#FF9800" />
                <TextView
                    android:id="@+id/btn_pan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:text="Verify PAN"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:background="@drawable/profile_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Insurance -->
            <LinearLayout
                android:id="@+id/card_insurance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/profile_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Insurance"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tv_insurance_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/reg_status_not_uploaded"
                    android:textSize="13sp"
                    android:textColor="#FF9800" />
                <TextView
                    android:id="@+id/btn_insurance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:text="Upload Insurance"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:background="@drawable/profile_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- PUC -->
            <LinearLayout
                android:id="@+id/card_puc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/profile_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PUC Certificate"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tv_puc_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/reg_status_not_uploaded"
                    android:textSize="13sp"
                    android:textColor="#FF9800" />
                <TextView
                    android:id="@+id/btn_puc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:text="Upload PUC"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:background="@drawable/profile_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Bank details -->
            <LinearLayout
                android:id="@+id/card_bank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/profile_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bank Details"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:fontFamily="sans-serif-medium" />
                <EditText
                    android:id="@+id/ed_acc_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Account holder name"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:background="@drawable/profile_input" />
                <EditText
                    android:id="@+id/ed_acc_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Account number"
                    android:inputType="number"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:background="@drawable/profile_input" />
                <EditText
                    android:id="@+id/ed_ifsc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="IFSC code"
                    android:inputType="textCapCharacters"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:background="@drawable/profile_input" />
            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:id="@+id/card_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/profile_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:fontFamily="sans-serif-medium" />
                <EditText
                    android:id="@+id/ed_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Email address"
                    android:inputType="textEmailAddress"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:background="@drawable/profile_input" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white">
        <TextView
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:padding="14dp"
            android:gravity="center"
            android:text="@string/reg_submit"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:background="@drawable/profile_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/btn_go_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:gravity="center"
            android:text="@string/reg_go_to_home"
            android:textSize="15sp"
            android:textColor="@color/driver_text_primary"
            android:background="@drawable/profile_soft"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</LinearLayout>
