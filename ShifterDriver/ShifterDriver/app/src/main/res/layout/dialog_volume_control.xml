<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/rounded_corner_box">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ringtone_volume_control"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/img_volume_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_volume"
            android:layout_marginRight="12dp"
            android:tint="@color/purple_700" />

        <SeekBar
            android:id="@+id/seekbar_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="15"
            android:progress="10"
            android:progressTint="@color/purple_700"
            android:thumbTint="@color/purple_700" />

        <TextView
            android:id="@+id/txt_volume_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="67%"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            android:minWidth="45dp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mute"
            android:textColor="@color/gray1"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/max"
            android:textColor="@color/gray1"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_volume_down"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:text="@string/volume_down"
            android:background="@drawable/rounded_button"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_volume_up"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="@string/volume_up"
            android:background="@drawable/rounded_button_green"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="14dp" />

    <!-- Order Alert Sound Mode Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/order_alert_sound"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Option 1: Voice Announcement -->
    <LinearLayout
        android:id="@+id/layout_option_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/bg_card_selectable"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/img_radio_voice"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/bg_radio_selected" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/txt_sound_voice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_mode_voice"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_mode_voice_desc"
                android:textColor="@color/gray1"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_preview_voice"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_volume"
            android:padding="6dp"
            android:background="@drawable/bg_circle_orange_light"
            android:tint="@color/purple_700"
            android:contentDescription="Preview Voice" />
    </LinearLayout>

    <!-- Option 2: Classic Ringtone -->
    <LinearLayout
        android:id="@+id/layout_option_ringtone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_unselected"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/img_radio_ringtone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/bg_radio_unselected" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/txt_sound_ringtone_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_mode_ringtone"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_mode_ringtone_desc"
                android:textColor="@color/gray1"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_preview_ringtone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_volume"
            android:padding="6dp"
            android:background="@drawable/bg_circle_orange_light"
            android:tint="@color/purple_700"
            android:contentDescription="Preview Ringtone" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_close_dialog"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/close"
        android:background="@drawable/rounded_button"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
