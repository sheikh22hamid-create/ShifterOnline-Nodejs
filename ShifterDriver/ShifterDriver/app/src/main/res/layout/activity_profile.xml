<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_canvas"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/white">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/img_back"
            android:src="@drawable/ic_back_left"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/partner_back"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/driver_text_primary"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/profile_edit_profile"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:id="@+id/profile_picture"
                    android:src="@drawable/user"
                    android:contentDescription="Profile photo"
                    app:civ_border_color="#FFFFFF"
                    app:civ_border_width="3dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textColor="@color/driver_text_primary"
                        android:text="@string/profile_your_partner_profile"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/home_secondary"
                        android:layout_marginTop="6dp"
                        android:text="@string/profile_keep_your_details_up_to_date" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/profile_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/driver_text_primary"
                    android:text="@string/profile_personal_details"
                    android:fontFamily="sans-serif-medium" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/home_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/profile_full_name"
                    android:labelFor="@id/edit_full_name" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_full_name"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:inputType="textPersonName"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:background="@drawable/profile_input"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/home_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/profile_date_of_birth"
                    android:labelFor="@id/edit_dob" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_dob"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:inputType="date"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:background="@drawable/profile_input"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/home_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/profile_nationality"
                    android:labelFor="@id/edit_nationality" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_nationality"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:inputType="textCapWords"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:background="@drawable/profile_input"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="false" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/profile_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/driver_text_primary"
                    android:text="@string/profile_contact_details"
                    android:fontFamily="sans-serif-medium" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/home_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/profile_mobile_number"
                    android:labelFor="@id/edit_mobile" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_mobile"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:inputType="phone"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:background="@drawable/profile_soft"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/home_secondary"
                    android:layout_marginTop="6dp"
                    android:text="@string/profile_your_registered_mobile_number_cannot_be_edited_here" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/home_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/profile_address"
                    android:labelFor="@id/edit_address" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_address"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:background="@drawable/profile_input"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="false"
                    android:minLines="2"
                    android:gravity="top|start" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/home_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/profile_languages_you_speak"
                    android:labelFor="@id/edit_language" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_language"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:textColorHint="@color/home_secondary"
                    android:inputType="textCapWords"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:background="@drawable/profile_input"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="false" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_registration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/profile_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/driver_text_primary"
                    android:text="@string/reg_incomplete_title"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:id="@+id/ll_reg_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:id="@+id/btn_complete_registration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="@string/complete_registration_btn"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:background="@drawable/profile_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/profile_soft"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/driver_text_primary"
                    android:text="@string/profile_verification"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/verification_status"
                    android:textSize="16sp"
                    android:textColor="@color/driver_text_primary"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txt_continue"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:minHeight="54dp"
            android:padding="14dp"
            android:background="@drawable/profile_action"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/profile_save_changes"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</LinearLayout>
