# Legacy KYC/vehicle document images are served from the backend's
# LEGACY_IMAGES_DIR static mount — point this at that backend's origin.
VITE_IMAGE_BASE_URL=http://localhost:5000

# REST API base path. Leave unset for local dev / same-origin deploys — falls
# back to the relative path '/api/v1/admin' (dev: proxied by vite.config.js;
# prod: reverse-proxied to the backend on the same domain). Set to a full
# origin (e.g. https://api.shifteronline.com/api/v1/admin) only when the
# frontend and backend are deployed on separate domains.
VITE_API_BASE_URL=

# Socket.io server origin. Leave unset to default to window.location.origin
# (same-origin deploys). Set to a full origin (e.g. https://api.shifteronline.com)
# when the backend lives on a different domain than the frontend.
VITE_SOCKET_URL=
