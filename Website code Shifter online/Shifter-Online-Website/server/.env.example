# Port the auth server listens on. Must match VITE_API_URL's port in the frontend's .env.
PORT=4000

# Origin allowed to call this API via CORS. Must match the frontend dev server URL.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign JWTs. Required — the server refuses to start without it.
# Generate one locally, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas connection string. Required — the server refuses to start without it.
# Backend-only secret: never reference this from frontend/Vite code or commit the real value.
MONGODB_URI=your_mongodb_atlas_connection_string

# Optional: database name to use within the Atlas cluster. Defaults to shifter_online.
MONGODB_DB_NAME=shifter_online

# Location search (/api/geocode/search) and route calculation (/api/routes/calculate)
# use the free OpenStreetMap Nominatim + OSRM public APIs — no API key required.
