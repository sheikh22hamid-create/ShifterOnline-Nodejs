# URL of the deployed Shifter Online API (see /server). Falls back to
# http://localhost:4000 for local development if this isn't set.
VITE_API_URL=http://localhost:4000

# The /estimate page's location search and map (OpenStreetMap Nominatim/OSRM
# via the backend, and Leaflet + OSM tiles in the browser) need no API key.
