<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">

            <solid android:color="@color/purple_700" />
            <gradient android:angle="90" android:endColor="@color/purple_500" android:startColor="#5F58FF" />
            <corners android:radius="5dp" />

            <stroke android:width="1dp" android:color="@color/purple_700" />

        </shape>
    </item>
    <item android:state_pressed="false">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">

            <solid android:color="#5F58FF" />
            <gradient android:angle="90" android:endColor="@color/purple_500" android:startColor="#5F58FF" android:type="linear" />

            <corners android:radius="5dp" />

            <stroke android:width="1dp" android:color="#5F58FF" />

        </shape>

    </item>
</selector>