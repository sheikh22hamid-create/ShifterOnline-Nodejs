<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Step Indicator -->
           <!-- <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_circle_primary"
                android:layout_marginBottom="16dp"/>-->

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete Your Profile"
                android:textColor="#1A1A1A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please provide the following details"
                android:textColor="#888888"
                android:textSize="14sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Mode Indicator Card -->
        <LinearLayout
            android:id="@+id/ll_mode_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_blue"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_white"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/img_mode_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_password"
                    android:layout_gravity="center"
                    app:tint="#1E88E5"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mode_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatic Verification"
                    android:textColor="#1E88E5"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tv_mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fields marked * are required"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Personal Details Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Details"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Full Name (Only for Manual) -->
        <LinearLayout
            android:id="@+id/ll_full_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/ed_full_name"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_white"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="Enter your full name"
                android:textColorHint="#BBBBBB"
                android:textColor="#333333"
                android:textSize="15sp"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"/>
        </LinearLayout>

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email ID"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/ed_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Enter your email"
            android:textColorHint="#BBBBBB"
            android:textColor="#333333"
            android:inputType="textEmailAddress"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            android:imeOptions="actionNext"/>

        <!-- Referral Code (Optional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Referral Code (Optional)"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/ed_referral_code"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Enter referral code (if any)"
            android:textColorHint="#BBBBBB"
            android:textColor="#333333"
            android:inputType="textCapCharacters"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            android:importantForAutofill="no"
            android:imeOptions="actionNext"/>

        <!-- Bank Details Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bank Details"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Account Holder Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Holder Name *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/ed_acc_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Enter account holder name"
            android:textColorHint="#BBBBBB"
            android:textColor="#333333"
            android:textSize="15sp"
            android:inputType="textPersonName|textCapWords"
            android:layout_marginBottom="16dp"
            android:imeOptions="actionNext"/>

        <!-- Account Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Number *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/ed_acc_number"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Enter account number"
            android:textColorHint="#BBBBBB"
            android:textColor="#333333"
            android:inputType="number"
            android:maxLength="18"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            android:imeOptions="actionNext"/>

        <!-- IFSC Code -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IFSC Code *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/ed_ifsc"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Enter IFSC code"
            android:textColorHint="#BBBBBB"
            android:textColor="#333333"
            android:textAllCaps="true"
            android:textSize="15sp"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="11"
            android:layout_marginBottom="16dp"
            android:imeOptions="actionNext"/>

        <!-- City Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="City *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinner_city"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Vehicle Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Type *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinner_vehicle_type"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Vehicle Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Number *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/ed_vehicle_no"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Enter vehicle number"
            android:textColorHint="#BBBBBB"
            android:textColor="#333333"
            android:textAllCaps="true"
            android:textSize="15sp"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:layout_marginBottom="24dp"
            android:imeOptions="actionNext"/>

        <!-- Document Upload Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Document Upload"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Aadhaar Card Front -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_white"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_green_light"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_document"
                    android:layout_gravity="center"
                    app:tint="#4CAF50"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_aadhaar_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aadhaar Card Front *"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_aadhaar_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not uploaded"
                    android:textColor="#FF6B00"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_aadhaar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Upload"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_btn_small"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>

        <!-- Aadhaar Card Back -->
        <LinearLayout
            android:id="@+id/ll_aadhaar_back_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_white"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_green_light"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_document"
                    android:layout_gravity="center"
                    app:tint="#4CAF50"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aadhaar Card Back *"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_aadhaar_back_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not uploaded"
                    android:textColor="#FF6B00"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_aadhaar_back"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Upload"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_btn_small"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>

        <!-- Driving License -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_white"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_blue_light"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_license"
                    android:layout_gravity="center"
                    app:tint="#1E88E5"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Driving License *"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_dl_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not uploaded"
                    android:textColor="#FF6B00"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_dl"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Upload"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_btn_small"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>

        <!-- Vehicle RC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_white"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_orange_light"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_car"
                    android:layout_gravity="center"
                    app:tint="#FF9800"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vehicle RC *"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_rc_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not uploaded"
                    android:textColor="#FF6B00"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_rc"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Upload"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_btn_small"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>

        <!-- PAN Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_white"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_purple_light"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_card"
                    android:layout_gravity="center"
                    app:tint="#9C27B0"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAN Card"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_pan_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Optional"
                    android:textColor="#888888"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_pan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Upload"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_btn_small"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>



        <!-- Footer Note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_green"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info"
                android:layout_marginEnd="8dp"
                app:tint="#4CAF50"/>

            <TextView
                android:id="@+id/tv_footer_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear photos ensure faster verification"
                android:textColor="#2E7D32"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Submit Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_next_details"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Complete Registration"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>