<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/box_boder2"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Place Your Bid"
        android:textColor="@color/purple_700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- Order ID -->
    <TextView
        android:id="@+id/tv_bid_order_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order #101"
        android:textColor="@color/gray1"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray"
        android:alpha="0.4"
        android:layout_marginBottom="20dp" />

    <!-- Amount label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Bid Amount (₹)"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Amount Input -->
    <EditText
        android:id="@+id/et_bid_amount"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/rounded_corner_box"
        android:hint="e.g. 150"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textColorHint="@color/gray1"
        android:layout_marginBottom="20dp" />

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btn_cancel_bid"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/rounded_corner_box"
            android:text="Cancel"
            android:textColor="@color/gray1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_submit_bid"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/rounded_button"
            android:text="Submit Bid"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
