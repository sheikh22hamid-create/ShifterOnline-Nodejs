<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/rounded_corner_box">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Driving License Verification"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_dl_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Driving License Number and Date of Birth"
            android:textColor="@color/gray1"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/ed_dl_number"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edittext_box"
            android:hint="DL Number (e.g. MP1320210012345)"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/ed_dl_dob"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edittext_box"
            android:hint="Date of Birth (YYYY-MM-DD)"
            android:focusable="false"
            android:clickable="true"
            android:padding="12dp"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- Loading Indicator / Message -->
        <TextView
            android:id="@+id/tv_dl_status_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/red"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Buttons Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btn_cancel_dl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/black"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#CCCCCC"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btn_submit_dl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Verify DL"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/white"
                android:background="@drawable/rounded_button"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
