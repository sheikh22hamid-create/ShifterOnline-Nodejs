<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F172A"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Trip Payment Details"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_close_header"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />
        </RelativeLayout>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:maxHeight="520dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <!-- ================= 1. FARE BREAKDOWN ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_badge_green_square"
                        android:gravity="center"
                        android:text="₹"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="FARE BREAKDOWN"
                        android:textColor="#15803D"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Fare Items Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <!-- Minimum charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_minimum_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:text="₹"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Minimum charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_minimum_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Actual pickup charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_actual_pickup_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Actual pickup charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_actual_pickup_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Pick up to drop charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_pickup_to_drop_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:text="🛣️"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Pick up to drop charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_pickup_to_drop_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Add stop charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_add_stop_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:text="ℹ️"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Add stop charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_add_stop_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Extra waiting time charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_waiting_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:text="⏱️"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Extra waiting time charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_waiting_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Night charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_night_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:text="🌙"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Night charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_night_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Loading charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_loading_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:text="⬆️"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Loading charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_loading_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Unloading charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_unloading_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            android:text="⬇️"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Unloading charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_unloading_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Final fare amount Strip -->
                <LinearLayout
                    android:id="@+id/layout_final_fare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_strip_green"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="= Final Fare Amount"
                        android:textColor="#15803D"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_final_fare_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0.00"
                        android:textColor="#15803D"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#E2E8F0" />


                <!-- ================= 2. DEDUCTIONS ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_badge_red_square"
                        android:gravity="center"
                        android:text="%"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="DEDUCTIONS"
                        android:textColor="#DC2626"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Deductions items -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <!-- Commission -->
                    <LinearLayout
                        android:id="@+id/layout_row_commission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="- Commission"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_commission"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#DC2626"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Per trip charge -->
                    <LinearLayout
                        android:id="@+id/layout_row_per_trip_charge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="- Per trip charge"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_per_trip_charge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#DC2626"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Total Deductions Row -->
                    <LinearLayout
                        android:id="@+id/layout_row_total_deductions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="= Total Deductions"
                            android:textColor="#DC2626"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_total_deductions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#DC2626"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Driver Total Earning Strip -->
                    <LinearLayout
                        android:id="@+id/layout_driver_earning_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_strip_blue"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="= Driver Total Earning"
                            android:textColor="#1D4ED8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_driver_total_earning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1D4ED8"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#E2E8F0" />


                <!-- ================= 3. PAYMENT BY USER ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_badge_blue_square"
                        android:gravity="center"
                        android:text="💳"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="PAYMENT BY USER"
                        android:textColor="#2563EB"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <!-- Total amount to be paid by user -->
                    <LinearLayout
                        android:id="@+id/layout_row_total_amount_by_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total amount to be paid by user"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_total_amount_by_user"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Advance payment -->
                    <LinearLayout
                        android:id="@+id/layout_row_advance_payment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="- Advance payment"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_advance_payment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#2563EB"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Cash to Collect Strip -->
                    <LinearLayout
                        android:id="@+id/layout_cash_to_collect_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_strip_blue"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="= Cash to Collect from User"
                            android:textColor="#1E40AF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_cash_to_collect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E40AF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#E2E8F0" />


                <!-- ================= 4. FINAL SETTLEMENT ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_badge_green_square"
                        android:gravity="center"
                        android:text="💼"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="FINAL SETTLEMENT"
                        android:textColor="#15803D"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <!-- Settlement Earning -->
                    <LinearLayout
                        android:id="@+id/layout_row_settlement_earning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Driver Total Earning"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_settlement_earning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Settlement Cash collected -->
                    <LinearLayout
                        android:id="@+id/layout_row_settlement_cash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="- Cash collected from user"
                            android:textColor="#334155"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_settlement_cash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Wallet Adjustment Strip -->
                    <LinearLayout
                        android:id="@+id/layout_wallet_adjustment_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_strip_green"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/txt_wallet_adjustment_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="= Wallet Adjustment"
                            android:textColor="#15803D"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_wallet_adjustment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#15803D"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Settlement Note Card -->
                    <LinearLayout
                        android:id="@+id/layout_settlement_note_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_note_green"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_settlement_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Driver settlement note"
                            android:textColor="#166534"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FAFC"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_dialog"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#0F172A"
                android:text="Close"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>