<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".android.activity.RiderKitActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/img_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:src="@drawable/ic_back_left" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="@string/rider_kit"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradit_white"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center|top"
            android:layout_margin="10dp"
            android:gravity="center|top"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/kit_needed"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">





                <LinearLayout
                    android:id="@+id/lvl_bicycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                </LinearLayout>





                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="10dp"
                    android:padding="5dp"
                    android:text="@string/kit"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:padding="5dp"
                    android:textStyle="bold"
                    android:text="@string/qu"
                    android:textColor="@color/black"
                    android:textSize="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:padding="5dp"
                    android:text="@string/ans"
                    android:textColor="@color/black"
                    android:textSize="12dp" />


                <RadioGroup
                    android:id="@+id/radiogroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:gravity="center|left"
                    android:orientation="vertical"
                    android:padding="0dp">

                    <RadioButton
                        android:id="@+id/rdi_option"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/box"
                        android:text="Yes" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp" />

                    <RadioButton
                        android:id="@+id/rdi_option2"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/box"
                        android:checked="true"

                        android:text="No" />

                </RadioGroup>

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
                <LinearLayout
                    android:id="@+id/lvl_upload"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/edittext_box"
                    android:gravity="center"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/img_frount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_img_dummy" />

                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp" />

                    <TextView
                        android:id="@+id/txt_uploadfrount"
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_box"
                        android:drawableLeft="@drawable/ic_upload_image"
                        android:gravity="center"
                        android:padding="7dp"
                        android:text="@string/upload_image" />

                </LinearLayout>
                <View
                    android:layout_width="20dp"
                    android:layout_height="30dp" />
                <TextView
                    android:id="@+id/txt_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/rounded_button"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="@string/submit"
                    android:theme="@style/AppTheme.Button" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="30dp" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>
</LinearLayout>