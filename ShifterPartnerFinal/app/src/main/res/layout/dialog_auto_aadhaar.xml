<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/rounded_corner_box">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aadhaar eKYC Verification"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_aadhaar_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your 12-digit Aadhaar number and Captcha"
            android:textColor="@color/gray1"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Step 1 Layout: Aadhaar + Captcha -->
        <LinearLayout
            android:id="@+id/ll_step1_aadhaar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/ed_aadhaar_number"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_box"
                android:hint="Enter 12-digit Aadhaar Number"
                android:inputType="number"
                android:maxLength="12"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <!-- Captcha View Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/img_captcha"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="#F0F0F0"
                    android:scaleType="fitCenter"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/btn_refresh_captcha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Refresh"
                    android:textColor="@color/purple_500"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="10dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/ed_captcha_value"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_box"
                android:hint="Enter Captcha Code"
                android:inputType="textNoSuggestions"
                android:maxLength="6"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <!-- Step 2 Layout: OTP Entry (Initially GONE) -->
        <LinearLayout
            android:id="@+id/ll_step2_aadhaar_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter 6-digit OTP sent to your Aadhaar linked mobile"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/ed_aadhaar_otp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_box"
                android:hint="Enter 6-Digit OTP"
                android:inputType="number"
                android:maxLength="6"
                android:gravity="center"
                android:padding="8dp"
                android:textSize="18sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <!-- Loading Indicator / Message -->
        <TextView
            android:id="@+id/tv_aadhaar_status_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/red"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Buttons Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btn_cancel_aadhaar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/black"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#CCCCCC"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btn_submit_aadhaar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Send OTP"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/white"
                android:background="@drawable/rounded_button"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
