<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/rounded_corner_box">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PAN Verification (Income Tax)"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_pan_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter PAN card details as per Income Tax records"
            android:textColor="@color/gray1"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Step 1 Layout: PAN Details -->
        <LinearLayout
            android:id="@+id/ll_step1_pan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/ed_pan_number"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_box"
                android:hint="PAN Number (e.g. ABCDE1234F)"
                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                android:maxLength="10"
                android:padding="12dp"
                android:textSize="15sp"
                android:importantForAutofill="no"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/ed_pan_full_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_box"
                android:hint="Full Name (as per PAN)"
                android:inputType="textPersonName|textCapWords"
                android:autofillHints="name"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/ed_pan_dob"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_box"
                android:hint="Date of Birth (YYYY-MM-DD)"
                android:focusable="false"
                android:clickable="true"
                android:importantForAutofill="no"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/ed_pan_mobile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_box"
                android:hint="Mobile Number"
                android:inputType="phone"
                android:maxLength="10"
                android:autofillHints="phoneNumber"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <!-- Step 2 Layout: OTP Entry (Initially GONE) -->
        <LinearLayout
            android:id="@+id/ll_step2_pan_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter 6-digit OTP sent to your mobile number"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/ed_pan_otp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_box"
                android:hint="Enter 6-Digit OTP"
                android:inputType="number"
                android:maxLength="6"
                android:gravity="center"
                android:padding="8dp"
                android:textSize="18sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <!-- Loading Indicator / Message -->
        <TextView
            android:id="@+id/tv_pan_status_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/red"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Buttons Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btn_cancel_pan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/black"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#CCCCCC"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btn_submit_pan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Send OTP"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/white"
                android:background="@drawable/rounded_button"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
