<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FF"
    android:orientation="vertical">

    <!-- ─── Gradient Header ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_plan_card_header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp">

        <!-- Back + Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_white"
                android:padding="8dp"
                android:src="@drawable/ic_back_left" />

            <TextView
                android:id="@+id/txt_toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Plan Details"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View android:layout_width="36dp" android:layout_height="36dp" />
        </LinearLayout>

        <!-- Plan name + price shown in header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_popular_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_popular_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="⭐ Most Popular"
                    android:textColor="#7C4DFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txt_plan_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_validity_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#D4BDFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_plan_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_next_renewal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D4BDFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ─── Scrollable Content ─── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Plan Summary Card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_plan_card_white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="📋 Plan Summary"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Summary rows -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Plan Price"
                        android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/txt_summary_price"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#5B2EE8" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Validity"
                        android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/txt_summary_validity"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#333333" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Per Trip Charge"
                        android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/txt_summary_trip_charge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#333333" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Commission"
                        android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/txt_summary_commission"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#333333" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
                    android:background="#F0EAFF" />

                <!-- Benefits -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="✨ Benefits"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ── Points + Payment Card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_plan_card_white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="💳 Payment Details"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Selected Plan -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Selected Plan"
                        android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/txt_selected_plan"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#333333" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Plan Price row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Plan Price"
                        android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/txt_plan_price_row"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#333333" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Available Points row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Available Points"
                        android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/txt_available_points"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#5B2EE8" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Points Stepper -->
                <LinearLayout
                    android:id="@+id/layout_points_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_info_purple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Use Points"
                        android:textColor="#5B2EE8" android:textSize="13sp" android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_pts_minus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="#5B2EE8"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_use_points"
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_pts_plus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_btn_purple"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Points Covered Amount -->
                <LinearLayout
                    android:id="@+id/layout_points_value_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Points Value"
                        android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/txt_points_value"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#E53935" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginBottom="12dp" android:background="#F0EAFF" />

                <!-- Amount to Pay (big highlight) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_purple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Amount to Pay"
                        android:textColor="#5B2EE8" android:textSize="14sp" android:textStyle="bold" />

                    <TextView android:id="@+id/txt_amount_to_pay"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#5B2EE8" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Payment Method label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Payment Method"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radio_payment_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_razorpay"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_info_purple"
                        android:paddingStart="14dp"
                        android:buttonTint="#5B2EE8"
                        android:checked="true"
                        android:text="💳  Card / UPI / Net Banking"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                </RadioGroup>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ─── Bottom Pay Button ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/btn_pay_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_purple"
            android:gravity="center"
            android:padding="16dp"
            android:text="Pay ₹499"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
