<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/box"

    app:ignore="NamespaceTypo">

    <LinearLayout
        android:id="@+id/lvl_itemclick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="vertical"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:text="Item Name"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:textStyle="bold" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            <TextView
                android:id="@+id/txt_uploadfrount"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:background="@drawable/edittext_box"
                android:backgroundTint="@color/white"
                android:drawableLeft="@drawable/ic_upload_image"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/upload_image"
                android:textColor="@color/black" />
                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp"/>
            <TextView
                android:id="@+id/txt_cancel"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:background="@drawable/edittext_box"
                android:backgroundTint="@color/applight"
                android:gravity="center"
                android:padding="10dp"
                android:visibility="visible"
                android:text="Itme Unavailable"
                android:textColor="@color/white" />
            </LinearLayout>
            <TextView
                android:id="@+id/txt_upload"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:background="@drawable/edittext_box"
                android:backgroundTint="@color/gray2"
                android:gravity="center"
                android:padding="10dp"
                android:visibility="gone"
                android:text="Pending"
                android:textColor="@color/white" />
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_recentorders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:padding="10dp"
            android:scrollbars="vertical" />

        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="@color/gray" />

        <LinearLayout
            android:id="@+id/lvl_price"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Enter price of this item (single quantity)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/edittext_box"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ed_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:background="@null"
                    android:gravity="start|center"
                    android:hint="@string/enter_amount"
                    android:inputType="phone"
                    android:padding="10dp"
                    android:textSize="14dp" />

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="@color/gray" />

        <TextView
            android:id="@+id/txt_continue"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/rounded_button"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/send"
            android:theme="@style/AppTheme.Button" />


        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="@color/gray" />
    </LinearLayout>


</LinearLayout>
