<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/rounded_corner_box">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle RC Verification"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_rc_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Vehicle Registration Number (e.g. MP13L3514)"
            android:textColor="@color/gray1"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/ed_rc_number"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edittext_box"
            android:hint="Vehicle Reg. No. (e.g. MP13L3514)"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- RC Details Result Layout (Initially GONE) -->
        <LinearLayout
            android:id="@+id/ll_rc_details_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F9F9F9"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_rc_owner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Owner: -"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_rc_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehicle Model: -"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_rc_status_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: -"
                android:textColor="@color/green"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Loading Indicator / Message -->
        <TextView
            android:id="@+id/tv_rc_status_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/red"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Buttons Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btn_cancel_rc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/black"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#CCCCCC"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btn_submit_rc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Verify RC"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/white"
                android:background="@drawable/rounded_button"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
